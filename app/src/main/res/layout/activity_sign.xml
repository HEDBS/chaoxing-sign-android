<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 顶部: 返回 + 课程名 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="16dp"
                android:text="← 返回" />

            <TextView
                android:id="@+id/tvCourseName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="检测中..."
            android:textSize="15sp" />

        <!-- 参数区: 手势画板(手势签到专用) -->
        <LinearLayout
            android:id="@+id/panelGesture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGestureHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请画出老师设置的手势（连线经过的中间点自动选中，画错可点重画）"
                android:textSize="13sp" />

            <com.example.chaoxingsign.GestureView
                android:id="@+id/gestureView"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvGestureCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="12sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tvGestureLoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFF3E0"
                android:padding="10dp"
                android:textSize="12sp"
                android:textColor="#E65100"
                android:text="📍 将使用默认位置签到"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnResetGesture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="24dp"
                android:text="重画" />
        </LinearLayout>

        <!-- 参数区: 签到码输入(签到码类型专用) -->
        <LinearLayout
            android:id="@+id/panelCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvCodeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="签到码"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="输入老师公布的码（数字）"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvCodeLoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFF3E0"
                android:padding="10dp"
                android:textSize="12sp"
                android:textColor="#E65100"
                android:text="📍 将使用默认位置签到"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 参数区: 位置 -->
        <LinearLayout
            android:id="@+id/panelLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="位置签到参数"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etLat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="纬度 (如 34.817)"
                android:inputType="numberDecimal"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etLon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="经度 (如 113.516)"
                android:inputType="numberDecimal"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="详细地址"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnPickLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🗺️ 地图选点" />
        </LinearLayout>

        <!-- 参数区: 二维码 enc -->
        <LinearLayout
            android:id="@+id/panelQrcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="二维码 enc (微信扫码后从链接中提取)"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etEnc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="如 1D0A628CK317F44CCC378M5KD92"
                android:maxLines="1" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:text="签到" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
